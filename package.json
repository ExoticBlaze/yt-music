{
  "name": "ytmusic-plus",
  "version": "1.4.4",
  "description": "YouTube Music, with a secure extension ecosystem.",
  "private": true,
  "main": "dist/main/main.cjs",
  "author": "YTMusic+ contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/launch.mjs",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "smoke": "npm run build && node scripts/launch.mjs --smoke-test",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:relay": "node scripts/build-relay.mjs",
    "format": "prettier --write src plugins plugin-sdk client server tests scripts *.md *.json"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.6.2",
    "peerjs": "1.5.5",
    "semver": "^7.7.2",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.ytmusicplus.desktop",
    "productName": "YTMusic+",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ExoticBlaze",
      "repo": "yt-music",
      "releaseType": "draft"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
